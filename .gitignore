# =========================
# Python - кэш и временные файлы
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# Виртуальные окружения
# =========================
venv/
.venv/
env/

# =========================
# IDE и редакторы
# =========================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# =========================
# Секретные и конфиденциальные файлы
# =========================
.env                 # переменные окружения (API ключи, пароли)
data/bot.db          # локальная база SQLite
data/stock.xlsx      # остатки склада / данные карточек
data/*.key           # приватные ключи
data/*.pem
data/*.crt
secrets/             # если есть отдельная папка с секретами
credentials/         # любые файлы с учётными данными
*.json               # пароли, токены, ID
*.yml
*.yaml

# =========================
# Фотографии и медиа (если содержат конфиденциальную информацию)
# =========================
photos/              # блокируем полностью
*.png
*.jpg
*.jpeg
*.gif
*.svg

# =========================
# Логи и временные файлы
# =========================
*.log
*.tmp
*.bak
*.swp
*.cache

# =========================
# Сборки, пакеты и дистрибутивы
# =========================
build/
dist/
*.egg-info/
*.egg
*.manifest
*.spec
